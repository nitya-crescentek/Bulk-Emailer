# Copy to .env.local (gitignored) and fill in real values. Do NOT put secrets
# in this file — it is committed to git.

# ---------------------------------------------------------------- Database ---
# Postgres connection. With Supabase, use the *pooled* connection string here
# (port 6543, add ?pgbouncer=true) and the *direct* one below.
#
# Supabase → Project Settings → Database → Connection string.
#   Pooled : postgresql://postgres.<ref>:<pw>@aws-...pooler.supabase.com:6543/postgres?pgbouncer=true
#   Direct : postgresql://postgres.<ref>:<pw>@aws-...pooler.supabase.com:5432/postgres
#
# If the password has special characters (@ : / ? # etc.) percent-encode them:
#   @ -> %40    (e.g. "Nitya@12" -> "Nitya%4012")
#
# Local Postgres example (set DIRECT_URL to the same value):
#   postgresql://postgres:postgres@127.0.0.1:5432/bulk_mailer
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Direct connection used only by `prisma migrate` (pgbouncer can't run migrations).
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ------------------------------------------------------------------ Secret ---
# Encrypts SMTP passwords and signs OTP codes. Minimum 16 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this makes existing saved SMTP passwords unreadable.
APP_SECRET="change-me-to-a-long-random-string"

# ------------------------------------------------------- System mailbox ------
# The platform's own SMTP (e.g. smtp2go) used to send account emails such as
# verification codes. This is NOT the SMTP profiles users add for campaigns.
# If left unset, in development the OTP is printed to the server console.
SYSTEM_SMTP_HOST="mail.smtp2go.com"
SYSTEM_SMTP_PORT="587"
# Leave SECURE unset to auto-pick (true for 465, STARTTLS otherwise).
# SYSTEM_SMTP_SECURE="false"
SYSTEM_SMTP_USER="your-smtp2go-username"
SYSTEM_SMTP_PASS="your-smtp2go-password"
SYSTEM_SMTP_FROM="Bulk Mailer <no-reply@yourdomain.com>"
